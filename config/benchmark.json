{
    "database": {
        "url": "postgresql+psycopg://postgres:password@localhost:5432/skillgenie"
    },
    "logging": {
        "level": "INFO"
    },
    "embeddings": {
        "provider": "sentence-transformers",
        "model": "BAAI/bge-small-en-v1.5",
        "dimensions": 384,
        "batch_size": 32
    },
    "openrouter": {
        "api_key": "",
        "base_url": "https://openrouter.ai/api/v1",
        "model": "openai/gpt-4.1-mini"
    },
    "learning": {
        "enabled": true,
        "auto_approval": false,
        "auto_publish": false,
        "min_execution_count": 5,
        "min_success_rate": 0.9,
        "mode": "AUTOMATIC"
    },
    "similarity": {
        "threshold": 0.85,
        "recommendation_threshold": 0.8,
        "auto_approval_threshold": 0.95
    },
    "monitoring": {
        "enabled": true,
        "interval_seconds": 60
    },
    "feedback": {
        "drift_threshold": 0.2,
        "drift_window_hours": 168
    },
    "mcp": {
        "enabled": true,
        "host": "127.0.0.1",
        "port": 3100
    },
    "integrations": {
        "enabled": true
    },
    "benchmark": {
        "success_overlap": 0.5
    },
    "governance": {
        "privacy": {
            "telemetry_enabled": true,
            "data_residency": "self-hosted",
            "redact_pii": true
        },
        "vault": {
            "path": "config/secrets",
            "key_env": "VAULT_KEY"
        }
    }
}